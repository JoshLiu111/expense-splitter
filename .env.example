# Copy to .env.local and fill in. Never commit real values.

# Postgres (Neon in production). Use the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth: a random 32+ byte secret (openssl rand -base64 32) and the
# app's public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
