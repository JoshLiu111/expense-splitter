# Copy to .env.local and fill in. Never commit real values.

# Postgres (Neon in production). Use the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth: a random 32+ byte secret (openssl rand -base64 32) and the
# app's public origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend, for verification and password-reset emails. Without a key, emails
# are logged to the console in development. EMAIL_FROM must use a domain
# verified in Resend (onboarding@resend.dev only reaches your own address).
RESEND_API_KEY=
EMAIL_FROM="Expense Splitter <no-reply@example.com>"

# ExchangeRate-API (https://www.exchangerate-api.com), used only on the
# server and cached daily in Postgres. Without a key, Expenses use the last
# cached rates (or a rate typed by hand).
CURRENCY_API_KEY=
CURRENCY_API_BASE_URL=https://v6.exchangerate-api.com/v6
